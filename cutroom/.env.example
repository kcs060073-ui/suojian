# 复制本文件为 .env 并填入你的 key（.env 已 gitignore，不会进仓库）。
# 脚本顶部 import "./load-env" 会自动把这里的变量灌进 process.env；shell 里手动 set 的同名变量优先。

# ── 火山方舟 Ark · LLM 规划（plan-brief.ts，文案 → brief.json）──
ARK_API_KEY=你的火山方舟key
# 规划模型：控制台「在线推理」查。coding plan 用 deepseek-v4-pro
ARK_MODEL=deepseek-v4-pro
# coding plan 必须用 /api/coding/v3；用标准 /api/v3 会 404「model does not exist」
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3

# ── Seedance · 文生视频生成 B-roll（generate-broll.ts）──
# 与 Ark 同一把 key；但视频生成走标准 /api/v3（不是 coding plan），需控制台开通 Seedance 模型
SEEDANCE_API_KEY=你的火山方舟key
SEEDANCE_MODEL=doubao-seedance-2-0-260128
SEEDANCE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 可选：固定随机种子，复现/微调同一画面
# SEEDANCE_SEED=12345

# ── Pexels · 库存素材检索（fetch-broll.ts，B-roll 备选源，可不填）──
# pexels.com/api 免费申请，月 2 万次
PEXELS_API_KEY=
